<div class="fixed left-0 top-0 h-screen w-64 bg-red-200 border-r border-gray-200 flex flex-col justify-between">
  <div class="p-4">
    <div class="text-lg font-semibold text-gray-800 pb-4 border-b border-gray-200 w-full flex items-center justify-center">CHS Distance</div>

    <nav class="mt-4 space-y-2">
      <%= link_to "Calendar", calendar_path, class: "flex justify-center block px-3 py-2 rounded hover:bg-gray-200 text-gray-700" %>
    </nav>
  </div>

  <div class="p-4 border-t border-gray-200">
    <div class="text-xs uppercase tracking-wide text-gray-500 mb-1">Profile</div>
    <%= link_to profiles_path, class: "block px-3 py-2 rounded bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 truncate" do %>
      <%= (session[:profile_name].presence || "Select Profile") %>
    <% end %>
  </div>
</div>
